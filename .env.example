# all optional
PORT=5496
RPC_URLS=https://rpc.mainnet.chain.robinhood.com   # a private RPC first (comma-separated) keeps 429s away
MEME_BACKFILL_H=24          # hours of Pons trades read on the first start
GAS_RESERVE_ETH=0.0004      # ETH always left in a user's wallet for gas
CHIRON_SHARE=0.1            # share of every buy that goes into Chiron's own token once its CA is set in /studio (0 to turn off, 0.25 at most)
#CREATOR_WALLET=            # public address that launches $CHIRON on Pons (default: the owner's, set in server/burn.mjs)
#BUYBACK_WALLET=            # public address of the buyback wallet; /studio only accepts this wallet's key
STUDIO_KEY=                 # /studio key (generated into data/burn/secrets.json when empty)
BURN_SECRET=
